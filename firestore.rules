rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "shamsunderjojare@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (data.email == null || (data.email is string && data.email.size() <= 100)) &&
             data.role in ['user', 'admin'] &&
             data.createdAt is string;
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.images is list && data.images.size() <= 10 &&
             (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0)) &&
             data.createdAt is string;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('image' in data) || (data.image is string && data.image.size() <= 5000000));
    }

    function isValidOrder(data) {
      return data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['Pending', 'Shipped', 'Delivered', 'Cancelled'] &&
             data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() < 500 &&
             data.paymentMethod in ['COD'] &&
             data.createdAt is string;
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() < 50 &&
             data.discountPercentage is number && data.discountPercentage > 0 && data.discountPercentage <= 100 &&
             data.expiryDate is string;
    }

    function isValidBanner(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 5000000 &&
             data.isActive is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged() && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && request.resource.data.status == 'Pending';
      // Only admins can update orders (e.g., status changes), or users can cancel their own pending orders
      allow update: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.status == 'Cancelled' && resource.data.status == 'Pending');
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCoupon(request.resource.data);
      allow update: if isAdmin() && isValidCoupon(request.resource.data);
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isAdmin() && isValidBanner(request.resource.data);
      allow update: if isAdmin() && isValidBanner(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // VIP Store Rules
    // ===============================================================

    match /vip_products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /vip_categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /vip_banners/{bannerId} {
      allow read: if true;
      allow create: if isAdmin() && isValidBanner(request.resource.data);
      allow update: if isAdmin() && isValidBanner(request.resource.data);
      allow delete: if isAdmin();
    }

    match /vip_orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && request.resource.data.status == 'Pending';
      allow update: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.status == 'Cancelled' && resource.data.status == 'Pending');
    }
  }
}
